# Optional: copy to .env (make .env does it) to change these. docker compose
# reads .env; never commit it.

# Shared bearer token between the backend and the MCP server over HTTP. Leave
# empty: compose generates one into a volume. To set your own, at least 32
# characters: openssl rand -hex 32
MCP_AUTH_TOKEN=

# fixture (offline corpus); exa and tavily arrive in Phase 1.
SEARCH_PROVIDER=fixture

# debug logs every ESPN request.
LOG_LEVEL=info

# true runs every LLM stage on the mock: no key, no cost, placeholder poems.
MOCK_LLM=false

# Optional development key for runs where the browser sends no key of its
# own. Leave empty to require a key in the UI's Your LLM drawer. Never set
# in the cloud.
LLM_MODEL=gemini/gemini-flash-latest
LLM_API_KEY=

# Development cache of the pick, moment and fact draft: running a week again
# with the same model makes only the poem and judge calls. compose sets it to
# a volume by default; uncomment to turn it off.
# ANALYSIS_CACHE_DIR=
