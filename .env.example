# Copy to .env (make .env does it and fills in a token). docker compose reads
# .env; never commit it.

# Shared bearer token between the backend and the MCP server over HTTP.
# At least 32 characters: openssl rand -hex 32
MCP_AUTH_TOKEN=

# fixture (offline corpus); exa and tavily arrive in Phase 1.
SEARCH_PROVIDER=fixture

# debug logs every ESPN request.
LOG_LEVEL=info

# The backend's LLM stages; false arrives with the real LiteLLM stages.
MOCK_LLM=true
